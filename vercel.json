{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index?path=:path*" }],
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "{lib/fonts/**,public/logo-full.png}" } },
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 22 1 * *" }],
  "headers": [
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
