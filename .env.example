# --- Majburiy ---
# PostgreSQL ulanishi (Vercel'da Neon ulansa avtomatik qo‘shiladi)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Login tokenlarini imzolash uchun uzun tasodifiy matn (kamida 32 belgi)
SESSION_SECRET=
# ↑ kamida 32 belgi: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Birinchi ishga tushishda yaratiladigan bosh admin (baza bo‘sh bo‘lsa)
OWNER_PHONE=+998901234567
OWNER_PASSWORD=
OWNER_NAME=Direktor

# --- Ixtiyoriy ---
# Bank to‘lov topshiriqnomasini avtomatik o‘qish (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Oylik tozalash (Vercel Cron) uchun maxfiy kalit
CRON_SECRET=
# Ma’lumotlarni necha oy saqlash (darslar, baholar, davomat). Moliya va o‘quvchilar o‘chirilmaydi.
RETENTION_MONTHS=24
# Fayllar: db (Vercel uchun) yoki disk (o‘z serveringizda)
FILE_STORAGE=db
# FILE_DIR=/var/lib/steamplaza/uploads
# Bitta fayl hajmi chegarasi, MB (Vercel: 3, o‘z serverda: 10). Rasmlar va PDF yuklanganda avtomatik siqiladi
# MAX_FILE_MB=10
# PORT=3000

# --- Xavfsizlik (3-versiya) ---
# Production'da NODE_ENV=production bo‘lsin: demo yuklash va demo hisoblar bilan kirish o‘chadi (ALLOW_DEMO=1 bilan yoqiladi)
# NODE_ENV=production
# Server faqat nginx orqasida ishlaydi (127.0.0.1). To‘g‘ridan-to‘g‘ri internetga chiqarsangiz HOST=0.0.0.0 va TRUST_PROXY=0
# HOST=127.0.0.1
# TRUST_PROXY=1
# Bir IP dan daqiqasiga so‘rovlar (umumiy / yozish)
# RATE_LIMIT=600
# WRITE_RATE_LIMIT=180
# Login: nechta noto‘g‘ri urinishdan keyin necha daqiqaga bloklanadi
# LOGIN_MAX_ATTEMPTS=6
# LOGIN_LOCK_MINUTES=15
# Login necha kun amal qiladi
# SESSION_DAYS=30
# REQUEST_TIMEOUT_MS=60000

# --- 4-versiya: shifrlash, demo, bildirishnomalar ---
# Ma’lumotlarni shifrlash kaliti (AES-256). 64 ta hex belgi: openssl rand -hex 32
# MUHIM: kalitni yo‘qotsangiz shifrlangan fayl va maydonlarni ochib bo‘lmaydi — zaxira joyda saqlang.
# Bo‘sh qolsa kalit SESSION_SECRET dan olinadi (unda SESSION_SECRET ni hech qachon o‘zgartirmang).
DATA_KEY=
# Kalitni almashtirganda eski kalit shu yerda turadi (npm run encrypt -- --rekey bilan qayta shifrlanadi)
# DATA_KEY_OLD=
# Sinov serverida production rejimida ham demo hisoblarni yoqish (haqiqiy maktab serverida yoqmang!)
# ALLOW_DEMO=1
# Brauzer push-bildirishnomalari (bo‘sh bo‘lsa kalitlar avtomatik yaratiladi va bazada shifrlangan holda saqlanadi)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@maktab.uz
# Rasm siqish: eng katta tomon (px) va JPEG sifati
# IMAGE_MAX_SIDE=2000
# IMAGE_QUALITY=78
# Profil PDF ichiga qo‘shiladigan hujjatlar chegarasi (MB va sahifa)
# PDF_ATTACH_MAX_MB=40
# PDF_ATTACH_MAX_PAGES=60
