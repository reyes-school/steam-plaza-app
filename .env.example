# --- Majburiy ---
# PostgreSQL ulanishi (Vercel'da Neon ulansa avtomatik qo‘shiladi)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Login tokenlarini imzolash uchun uzun tasodifiy matn (kamida 32 belgi)
SESSION_SECRET=
# Birinchi ishga tushishda yaratiladigan bosh admin (baza bo‘sh bo‘lsa)
OWNER_PHONE=+998901234567
OWNER_PASSWORD=
OWNER_NAME=Direktor

# --- Ixtiyoriy ---
# Bank to‘lov topshiriqnomasini avtomatik o‘qish (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Oylik tozalash (Vercel Cron) uchun maxfiy kalit
CRON_SECRET=
# Ma’lumotlarni necha oy saqlash (darslar, baholar, davomat). Moliya va o‘quvchilar o‘chirilmaydi.
RETENTION_MONTHS=24
# Fayllar: db (Vercel uchun) yoki disk (o‘z serveringizda)
FILE_STORAGE=db
# FILE_DIR=/var/lib/steamplaza/uploads
# MAX_FILE_MB=3
# PORT=3000
